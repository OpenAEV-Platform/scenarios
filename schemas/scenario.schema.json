{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenAEV-Platform/scenarios/schemas/v1/scenario.schema.json",
  "title": "OpenAEV scenario metadata",
  "description": "Metadata of one scenario entry (scenario.yaml). Draft until the format is confirmed on the starter-pack scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "version",
    "status",
    "name",
    "description",
    "severity",
    "category",
    "main_focus",
    "type",
    "platforms",
    "threat",
    "sources",
    "requires",
    "payloads"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "external_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "DEPRECATED",
        "REVOKED"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "main_focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "type": {
      "enum": [
        "time-based",
        "chained"
      ]
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "description": "Empty only for a tabletop scenario, that is one where no inject needs an executor and there is no payload.",
      "items": {
        "enum": [
          "Linux",
          "Windows",
          "MacOS",
          "Android",
          "iOS",
          "Container",
          "Service",
          "Generic",
          "Internal",
          "Unknown"
        ]
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          }
        },
        "intrusion_sets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "ttps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "tlp"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "tlp": {
            "const": "TLP:CLEAR"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openaev",
        "edition",
        "injectors",
        "executors"
      ],
      "properties": {
        "openaev": {
          "type": "string",
          "pattern": "^(>=|>|==|~=)[0-9]+(\\.[0-9]+)*$"
        },
        "edition": {
          "enum": [
            "CE",
            "EE"
          ]
        },
        "injectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "executors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payload_reference"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placeholder",
          "description"
        ],
        "properties": {
          "placeholder": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "generated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threat_fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "payload_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
