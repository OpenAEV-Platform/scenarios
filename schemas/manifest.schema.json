{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenAEV-Platform/scenarios/schemas/v1/manifest.schema.json",
  "title": "OpenAEV content release manifest",
  "description": "List of the items of one release on one channel, with the hash of every archive. Serialised in RFC 8785 canonical form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "channel",
    "issued_at",
    "release",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "const": "OpenAEV-Platform/scenarios"
    },
    "channel": {
      "enum": [
        "edge",
        "stable"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 10000
    },
    "release_approver": {
      "$ref": "#/$defs/github_login",
      "description": "Added by the release job after the release approval. Absent from the build output; required by the verifier in an approved manifest."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "github_login": {
      "type": "string",
      "description": "A GitHub login in lower case: logins are case-insensitive, and a canonical case lets uniqueness count distinct accounts.",
      "maxLength": 39,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "version",
        "status",
        "name",
        "description",
        "severity",
        "category",
        "main_focus",
        "platforms",
        "threat",
        "type",
        "tabletop",
        "requires",
        "archive",
        "payloads",
        "test_report",
        "approvals"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "DEPRECATED",
            "REVOKED"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "main_focus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "description": "A catalogue facet chosen by the contributor; it must include every platform targeted by an inject that needs an executor, which is checked against the export. At least one value, so that the scenario appears under some platform filter; for instance Generic for a scenario that runs on no endpoint.",
          "items": {
            "enum": [
              "Linux",
              "Windows",
              "MacOS",
              "Android",
              "iOS",
              "Container",
              "Service",
              "Generic",
              "Internal",
              "Unknown"
            ]
          }
        },
        "threat": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cves": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
              }
            },
            "intrusion_sets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "ttps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
              }
            }
          }
        },
        "type": {
          "enum": [
            "time-based",
            "chained"
          ]
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openaev",
            "edition",
            "injectors",
            "executors"
          ],
          "properties": {
            "openaev": {
              "type": "string",
              "pattern": "^(>=|>|==|~=)[0-9]+(\\.[0-9]+)*$"
            },
            "edition": {
              "enum": [
                "CE",
                "EE"
              ]
            },
            "injectors": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 50
            },
            "executors": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 50
            }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "size"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.zip$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "payloads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
              },
              "version": {
                "$ref": "#/$defs/semver"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "maxItems": 1000
        },
        "test_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "release"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "release": {
              "type": "string",
              "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
            }
          }
        },
        "tabletop": {
          "type": "boolean"
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pull_request",
            "approvers"
          ],
          "properties": {
            "pull_request": {
              "type": "integer",
              "minimum": 1
            },
            "approvers": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/github_login"
              }
            }
          }
        }
      }
    }
  }
}
